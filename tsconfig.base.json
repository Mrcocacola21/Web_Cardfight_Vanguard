{
  "compilerOptions": {
    "target": "ES2022",
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "useUnknownInCatchVariables": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "baseUrl": ".",
    "paths": {
      "@web-vg/catalog": ["packages/catalog/src/index.ts"],
      "@web-vg/db": ["packages/db/src/index.ts"],
      "@web-vg/db/repositories": ["packages/db/src/repositories/index.ts"],
      "@web-vg/db/repositories/catalog": [
        "packages/db/src/repositories/catalog/index.ts"
      ],
      "@web-vg/db/repositories/collections": [
        "packages/db/src/repositories/collections/index.ts"
      ],
      "@web-vg/db/repositories/decks": [
        "packages/db/src/repositories/decks/index.ts"
      ],
      "@web-vg/db/repositories/gameplay": [
        "packages/db/src/repositories/gameplay/index.ts"
      ],
      "@web-vg/db/repositories/importer": [
        "packages/db/src/repositories/importer/index.ts"
      ],
      "@web-vg/db/repositories/matches": [
        "packages/db/src/repositories/matches/index.ts"
      ],
      "@web-vg/db/repositories/profiles": [
        "packages/db/src/repositories/profiles/index.ts"
      ],
      "@web-vg/db/repositories/social": [
        "packages/db/src/repositories/social/index.ts"
      ],
      "@web-vg/deck-validation": ["packages/deck-validation/src/index.ts"],
      "@web-vg/decks": ["packages/decks/src/index.ts"],
      "@web-vg/importer": ["packages/importer/src/index.ts"],
      "@web-vg/legality": ["packages/legality/src/index.ts"],
      "@web-vg/match-session": ["packages/match-session/src/index.ts"],
      "@web-vg/rules-core": ["packages/rules-core/src/index.ts"],
      "@web-vg/shared": ["packages/shared/src/index.ts"],
      "@web-vg/social": ["packages/social/src/index.ts"],
      "@web-vg/ui": ["packages/ui/src/index.ts"]
    }
  }
}
