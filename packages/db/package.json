{
  "name": "@web-vg/db",
  "private": true,
  "version": "0.0.0",
  "description": "Database and persistence foundation scaffold for the Cardfight!! Vanguard platform",
  "exports": {
    ".": "./src/index.ts",
    "./repositories": "./src/repositories/index.ts",
    "./repositories/catalog": "./src/repositories/catalog/index.ts",
    "./repositories/collections": "./src/repositories/collections/index.ts",
    "./repositories/decks": "./src/repositories/decks/index.ts",
    "./repositories/gameplay": "./src/repositories/gameplay/index.ts",
    "./repositories/importer": "./src/repositories/importer/index.ts",
    "./repositories/matches": "./src/repositories/matches/index.ts",
    "./repositories/profiles": "./src/repositories/profiles/index.ts",
    "./repositories/social": "./src/repositories/social/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint src --max-warnings=0",
    "seed": "node ./scripts/seed.mjs",
    "test": "vitest run",
    "test:db": "node ./scripts/test-db.mjs",
    "test:db:decks": "node ./scripts/test-db.mjs --suite=decks",
    "types:generate": "node ./scripts/generate-types.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@web-vg/match-session": "workspace:*",
    "@supabase/supabase-js": "^2.102.1",
    "pg": "^8.20.0"
  }
}
