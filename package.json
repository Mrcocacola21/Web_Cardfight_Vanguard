{
  "name": "web-vg",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo foundation for the Cardfight!! Vanguard web client / companion platform",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "corepack pnpm --filter @web-vg/web dev",
    "build": "corepack pnpm --filter @web-vg/web build",
    "lint": "corepack pnpm -r --if-present run lint",
    "lint:fix": "corepack pnpm -r --if-present run lint -- --fix",
    "lint:staged": "lint-staged",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "corepack pnpm test:unit && corepack pnpm test:web",
    "test:unit": "corepack pnpm --filter @web-vg/shared --filter @web-vg/catalog --filter @web-vg/decks --filter @web-vg/importer --filter @web-vg/legality --filter @web-vg/rules-core --filter @web-vg/social -r run test",
    "test:web": "corepack pnpm --filter @web-vg/web run test",
    "test:e2e": "corepack pnpm exec playwright test",
    "typecheck": "corepack pnpm -r --if-present run typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "25.5.2",
    "@eslint/js": "9.39.4",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.2",
    "eslint-config-prettier": "10.1.8",
    "globals": "^17.4.0",
    "husky": "9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "16.4.0",
    "prettier": "3.8.1",
    "turbo": "^2.9.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.0",
    "vite": "^8.0.7",
    "vitest": "^4.1.3"
  }
}
